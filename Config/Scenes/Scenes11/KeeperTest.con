call Includes/Normal
ar trueGameState off

# all views are defined in another script
call Includes/Views

dr debugDrawing3d:representation:RobotPose
dr representation:SetupPoses:place

# keep robot2 and robot3 as active field players so goalkeeper stays in goal
# penalize the rest
robot robot4
pr manual
robot robot5
pr manual
robot robot6
pr manual
robot robot7
pr manual
robot robot1
